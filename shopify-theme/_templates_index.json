    "custom_liquid_tea8Tf": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n\n.orbi-faq{\n    background:#f5f2ea;\n    padding:70px 20px;\n    font-family:var(--font-body-family);\n}\n\n.orbi-faq-container{\n    max-width:900px;\n    margin:0 auto;\n}\n\n.orbi-faq-title{\n    text-align:center;\n    font-family:var(--font-heading-family);\n    font-size:38px;\n    color:#222;\n    margin-bottom:12px;\n    font-weight:500;\n}\n\n.orbi-faq-subtitle{\n    text-align:center;\n    font-family:var(--font-body-family);\n    color:#666;\n    font-size:15px;\n    margin-bottom:45px;\n}\n\n.orbi-faq-item{\n    background:#fff;\n    border-radius:15px;\n    margin-bottom:16px;\n    box-shadow:0 3px 14px rgba(0,0,0,.06);\n    overflow:hidden;\n}\n\n.orbi-faq-question{\n    padding:22px 28px;\n    cursor:pointer;\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    font-family:var(--font-body-family);\n    font-size:18px;\n    font-weight:500;\n    color:#222;\n}\n\n.orbi-faq-icon{\n    font-size:27px;\n    color:#9b7d43;\n    transition:.3s;\n}\n\n.orbi-faq-answer{\n    max-height:0;\n    overflow:hidden;\n    transition:max-height .35s ease;\n}\n\n.orbi-faq-answer p{\n    padding:0 28px 22px;\n    font-family:var(--font-body-family);\n    color:#666;\n    line-height:1.7;\n    font-size:14px;\n}\n\n.orbi-faq-item.active .orbi-faq-answer{\n    max-height:250px;\n}\n\n.orbi-faq-item.active .orbi-faq-icon{\n    transform:rotate(45deg);\n}\n\n\n@media(max-width:768px){\n\n.orbi-faq{\n    padding:50px 15px;\n}\n\n.orbi-faq-title{\n    font-size:30px;\n}\n\n.orbi-faq-subtitle{\n    font-size:14px;\n    margin-bottom:35px;\n}\n\n.orbi-faq-question{\n    font-size:16px;\n    padding:18px 20px;\n}\n\n.orbi-faq-icon{\n    font-size:24px;\n}\n\n.orbi-faq-answer p{\n    padding:0 20px 18px;\n    font-size:14px;\n}\n\n}\n\n</style>\n\n\n<section class=\"orbi-faq\">\n<div class=\"orbi-faq-container\">\n<h2 class=\"orbi-faq-title\">\nFrequently Asked Questions\n</h2>\n<p class=\"orbi-faq-subtitle\">\nEverything you need to know about our furniture, delivery, returns and support.\n</p>\n\n<div class=\"orbi-faq-item\">\n<div class=\"orbi-faq-question\">\n<span>What products does Green Lane Furniture offer?</span>\n<span class=\"orbi-faq-icon\">+</span>\n</div>\n<div class=\"orbi-faq-answer\">\n<p>\nWe offer a carefully selected range of home furniture, including sofas and sofa beds, armchairs and loveseats, ottoman storage beds, footstools and ottomans, designed for modern UK homes.\n</p>\n</div>\n</div>\n\n<div class=\"orbi-faq-item\">\n<div class=\"orbi-faq-question\">\n<span>How do I choose the right sofa or bed size?</span>\n<span class=\"orbi-faq-icon\">+</span>\n</div>\n<div class=\"orbi-faq-answer\">\n<p>\nMeasure your room, doorways, stairs and hallways before ordering. Every product page lists the dimensions, and our team can help you check that a piece will fit and get into your home.\n</p>\n</div>\n</div>\n\n<div class=\"orbi-faq-item\">\n<div class=\"orbi-faq-question\">\n<span>How long does delivery take?</span>\n<span class=\"orbi-faq-icon\">+</span>\n</div>\n<div class=\"orbi-faq-answer\">\n<p>\nOrders placed before 2:00 PM (UK time) on a business day are processed the same day. Standard UK delivery usually takes 5–8 business days and is free on all orders.\n</p>\n</div>\n</div>\n\n<div class=\"orbi-faq-item\">\n<div class=\"orbi-faq-question\">\n<span>What is your return policy?</span>\n<span class=\"orbi-faq-icon\">+</span>\n</div>\n<div class=\"orbi-faq-answer\">\n<p>\nYou can return eligible new and unused items within 14 days of receiving your order. Please contact our support team before sending a return. Your statutory rights are not affected.\n</p>\n</div>\n</div>\n\n<div class=\"orbi-faq-item\">\n<div class=\"orbi-faq-question\">\n<span>Do you offer assembly?</span>\n<span class=\"orbi-faq-icon\">+</span>\n</div>\n<div class=\"orbi-faq-answer\">\n<p>\nMany of our items arrive ready to use or need only simple assembly with instructions included. Contact us before ordering if you would like to ask about assembly support for your area.\n</p>\n</div>\n</div>\n\n<div class=\"orbi-faq-item\">\n<div class=\"orbi-faq-question\">\n<span>How can I contact customer support?</span>\n<span class=\"orbi-faq-icon\">+</span>\n</div>\n<div class=\"orbi-faq-answer\">\n<p>\nOur team is available Monday to Friday, 9:00 AM – 6:00 PM (UK time). Email contact@greenlanefurniture.co.uk or call +44 7414 892530. We aim to reply to all enquiries within one business day.\n</p>\n</div>\n</div>\n\n</div>\n</section>\n\n<script>\n\ndocument.querySelectorAll(\".orbi-faq-question\").forEach(function(question){\n\nquestion.addEventListener(\"click\",function(){\n\nconst item=this.parentElement;\n\ndocument.querySelectorAll(\".orbi-faq-item\").forEach(function(i){\n\nif(i!==item){\ni.classList.remove(\"active\");\n}\n\n});\n\nitem.classList.toggle(\"active\");\n\n});\n\n});\n\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
