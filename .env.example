# Public site URL (canonical + Open Graph). Use production domain on Vercel.
NEXT_PUBLIC_SITE_URL=https://greenlanefurniture.co.uk

# Optional default share image (1200×630). Falls back to a stock interior photo.
# NEXT_PUBLIC_OG_IMAGE_URL=https://greenlanefurniture.co.uk/og.jpg

# WooCommerce (server-only — do not prefix with NEXT_PUBLIC_)
WORDPRESS_URL=https://shop.greenlanefurniture.co.uk
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Stripe card checkout (public)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# Set true while card charge/redirect is down — order still saves to WooCommerce
# NEXT_PUBLIC_STRIPE_CARD_PAUSED=true
