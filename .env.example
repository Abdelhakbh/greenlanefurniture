# Public site URL (canonical + Open Graph). Use production domain on Vercel.

NEXT_PUBLIC_SITE_URL=https://greenlanefurniture.co.uk



# Optional default share image (1200×630). Falls back to a stock interior photo.

# NEXT_PUBLIC_OG_IMAGE_URL=https://greenlanefurniture.co.uk/og.jpg



# WooCommerce (server-only — do not prefix with NEXT_PUBLIC_)

WORDPRESS_URL=https://shop.greenlanefurniture.co.uk

WOOCOMMERCE_CONSUMER_KEY=

WOOCOMMERCE_CONSUMER_SECRET=



# Stripe — publishable key is safe in the browser; secret key is server-only (Vercel).

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

STRIPE_SECRET_KEY=sk_live_...



# Telegram — new order alerts for the team (server-only)

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=



# Shopify checkout (browse on site / Woo feed; pay on Shopify)

SHOPIFY_STORE_DOMAIN=uwmdi7-eh.myshopify.com

# After connecting checkout.greenlanefurniture.co.uk in Shopify → Settings → Domains
SHOPIFY_CHECKOUT_DOMAIN=checkout.greenlanefurniture.co.uk

SHOPIFY_CLIENT_ID=

SHOPIFY_CLIENT_SECRET=

# Set to 0 to restore Woo bank-transfer checkout

NEXT_PUBLIC_SHOPIFY_CHECKOUT=1

SHOPIFY_CHECKOUT=1

# Vercel Cron + POST /api/admin/sync-shopify-inventory (Authorization: Bearer …)

CRON_SECRET=

SYNC_SHOPIFY_INVENTORY_SECRET=

# Sale alerts (Shopify webhook → /api/webhooks/shopify/orders)

SALE_NOTIFY_EMAIL=abdegeeK@gmail.com

# https://resend.com — required for email alerts

RESEND_API_KEY=

# Optional: custom From after domain verified in Resend

# SALE_NOTIFY_FROM=Green Lane Furniture <orders@greenlanefurniture.co.uk>

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

